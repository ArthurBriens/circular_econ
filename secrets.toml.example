# Copy to .streamlit/secrets.toml and fill in. That file is gitignored.
# On Streamlit Community Cloud, paste this block into
# Manage app -> Settings -> Secrets instead (never commit it).
#
# Any URL the server can GET without an interactive login works:
#   - S3 / GCS / Azure pre-signed link  (note: these EXPIRE - set a long TTL
#     or plan to rotate them)
#   - Google Drive:  https://drive.google.com/uc?export=download&id=FILE_ID
#   - Dropbox:       ...?dl=1   (not ?dl=0, which returns an HTML preview page)
#   - any private web host
#
# These URLs are credentials: whoever holds one can read the file. Treat them
# like passwords and rotate if one is exposed.

[data]
msm_url = "https://…/REP.csv"
trt_url = "https://…/traitements_REP.csv"
ref_url = "https://…/Referentiels_MSM.xlsx"

# Optional. Without it the targets page uses its placeholder set.
# See docs/targets_csv_schema.md for the file specification.
targets_url = "https://…/targets_fr_br.csv"
